layout {
    gaps 16
    center-focused-column "never"

    // Transparent desktop background (keeps live wallpapers static)
    background-color "transparent"

    preset-column-widths {
        proportion 0.25
        proportion 0.5
        proportion 0.75
        proportion 1.0
    }

    // Nullscapes space cyberpunk gradient (Blue -> Purple)
    focus-ring {
        width 2.5
        active-gradient from="#678FE4" to="#AB66CC" angle=135 relative-to="workspace-view"
        inactive-color "transparent"
    }

    // Column tab indicator: neon capsule
    tab-indicator {
        hide-when-single-tab
        place-within-column
        gap 6
        width 4
        length total-proportion=0.85
        position "top"
        active-gradient from="#678FE4" to="#AB66CC" angle=90
        inactive-color "#1B243788"
        corner-radius 6
    }

    // Deep translucent shadow
    shadow {
        on
        softness 42
        spread 5
        offset x=0 y=10
        color "#050711cc"
    }

    // Inner gaps from screen edges to the strip
    struts {
        left 10
        right 10
        top 8
        bottom 10
    }
}
