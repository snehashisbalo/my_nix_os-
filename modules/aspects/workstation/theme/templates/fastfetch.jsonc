// Rendered by Noctalia (user template "fastfetch") into
// <config>/fastfetch/config.jsonc. DO NOT EDIT: regenerated on every theme
// change. The logo it points at is installed by tools/system.nix.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/easy.png",
    "width": 26,
    "height": 13,
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": " 󰅂 ",
    "color": { "separator": "bright_black" }
  },
  "modules": [
    { "type": "custom", "format": "\u001b[38;2;{{ colors.primary.default.red }};{{ colors.primary.default.green }};{{ colors.primary.default.blue }}m╭─    System ───────────────────────────────────────\u001b[0m" },
    { "type": "os", "key": "│   Distro      ", "keyColor": "{{ colors.primary.default.hex }}" },
    { "type": "kernel", "key": "│ 󰌢  Kernel      ", "keyColor": "{{ colors.primary.default.hex }}" },
    { "type": "uptime", "key": "│ 󱫐  Uptime      ", "keyColor": "{{ colors.primary.default.hex }}" },
    { "type": "command", "key": "│ 󰔠  OS Age      ", "keyColor": "{{ colors.primary.default.hex }}", "text": "echo $(( ($(date +%s) - $(cat ~/.config/fastfetch/install-date 2>/dev/null || stat -c %Y /nix/store 2>/dev/null || stat -c %Y /etc/nixos)) / 86400 )) days" },
    { "type": "custom", "format": "\u001b[38;2;{{ colors.primary.default.red }};{{ colors.primary.default.green }};{{ colors.primary.default.blue }}m╰───────────────────────────────────────────────────\u001b[0m" },
    { "type": "custom", "format": "\u001b[38;2;{{ colors.tertiary.default.red }};{{ colors.tertiary.default.green }};{{ colors.tertiary.default.blue }}m╭─ 󱂬  Desktop ──────────────────────────────────────\u001b[0m" },
    { "type": "wm", "key": "│ 󰧨  Compositor  ", "keyColor": "{{ colors.tertiary.default.hex }}" },
    { "type": "terminal", "key": "│   Terminal    ", "keyColor": "{{ colors.tertiary.default.hex }}" },
    { "type": "shell", "key": "│ 󰞷  Shell       ", "keyColor": "{{ colors.tertiary.default.hex }}" },
    { "type": "display", "key": "│ 󰍹  Monitor     ", "keyColor": "{{ colors.tertiary.default.hex }}" },
    { "type": "custom", "format": "\u001b[38;2;{{ colors.tertiary.default.red }};{{ colors.tertiary.default.green }};{{ colors.tertiary.default.blue }}m╰───────────────────────────────────────────────────\u001b[0m" },
    { "type": "custom", "format": "\u001b[38;2;{{ colors.secondary.default.red }};{{ colors.secondary.default.green }};{{ colors.secondary.default.blue }}m╭─   Hardware ───────────────────────────────\u001b[0m" },
    { "type": "cpu", "key": "│   CPU         ", "keyColor": "{{ colors.secondary.default.hex }}" },
    { "type": "gpu", "key": "│ 󰢮  GPU         ", "keyColor": "{{ colors.secondary.default.hex }}", "format": "{1} {2}" },
    { "type": "memory", "key": "│ 󰘚  Memory      ", "keyColor": "{{ colors.secondary.default.hex }}" },
    { "type": "disk", "key": "│ 󰋊  Disk (Root) ", "folders": "/", "keyColor": "{{ colors.secondary.default.hex }}" },
    { "type": "custom", "format": "\u001b[38;2;{{ colors.secondary.default.red }};{{ colors.secondary.default.green }};{{ colors.secondary.default.blue }}m╰───────────────────────────────────────────────────\u001b[0m" },
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
